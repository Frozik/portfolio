{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "moon run portfolio:analyze",
    "build": "moon run :build",
    "check-all": "moon run :lint :format-check :type-check :layers :knip :conventions :test",
    "conventions": "moon run root:conventions",
    "conventions:baseline": "moon run root:conventions-baseline",
    "coverage": "moon run root:test-coverage",
    "dev": "moon run portfolio:dev",
    "format": "moon run root:format",
    "format-check": "moon run root:format-check",
    "knip": "moon run root:knip",
    "layers": "moon run root:layers",
    "lighthouse": "moon run portfolio:lighthouse",
    "lint": "moon run root:lint",
    "lint-fix": "moon run root:lint-fix",
    "prepare": "lefthook install",
    "setup": "moon setup",
    "test": "moon run root:test",
    "test:watch": "moon run root:test-watch",
    "types": "moon run :type-check"
  },
  "devDependencies": {
    "@frozik/tooling": "workspace:*",
    "@lhci/cli": "catalog:",
    "@moonrepo/cli": "catalog:",
    "@semantic-release/commit-analyzer": "catalog:",
    "@semantic-release/github": "catalog:",
    "@semantic-release/release-notes-generator": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "conventional-changelog-conventionalcommits": "catalog:",
    "dependency-cruiser": "catalog:",
    "happy-dom": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "lighthouse": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "semantic-release": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
