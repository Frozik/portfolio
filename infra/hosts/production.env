# production — the box that serves retro and conf.
#
# Declarative facts only; no secrets. The Yandex client_secret and the TURN
# secret live on the machine itself (/etc/communication/, mode 600) and are
# never recorded here. See infra/README.md.
#
# Used as: bash infra/bin/provision-host.sh --host production
# Explicit flags still win over anything set here.

SSH_HOST=root@2.26.113.92

COMMUNICATION_IP=2.26.113.92
COMMUNICATION_DOMAIN=2.26.113.92.sslip.io
COMMUNICATION_CORS_ORIGINS=https://frozik.github.io,http://localhost:5173

# Public OAuth identifiers — they ship in the browser bundle anyway.
GOOGLE_OAUTH_CLIENT_ID=546212190722-6m9ad4onbk252t78mar3f76hhck0bbcc.apps.googleusercontent.com
YANDEX_OAUTH_CLIENT_ID=d20efa3c92f14bfdae36f12037012319

# HAProxy terminates :443 and routes by SNI between the app and coturn.
EDGE_HAPROXY_ENABLED=true

# Let's Encrypt contact. Not recovered from the existing install (the ACME
# account carries no contact), so provisioning still needs --cert-email.
CERT_EMAIL=

# What CI deploys through (infra/roles/communication/deploy-user.sh).
DEPLOY_SSH_TARGET=deploy@2.26.113.92
