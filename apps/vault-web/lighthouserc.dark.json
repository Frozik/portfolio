{
  "ci": {
    "collect": {
      "startServerCommand": "NO_COLOR=1 pnpm exec vite preview --port 4175 --strictPort",
      "startServerReadyPattern": "localhost:4175",
      "startServerReadyTimeout": 60000,
      "url": ["http://localhost:4175/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--blink-settings=preferredColorScheme=0"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 300000
          }
        ],
        "resource-summary:third-party:size": [
          "error",
          {
            "maxNumericValue": 0
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/dark"
    }
  }
}
