{
  "name": "@frozik/vault-web",
  "version": "0.1.0",
  "private": true,
  "description": "Ciphra Vault: the password vault as an installable, offline web app",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:kill-switch": "VAULT_WEB_KILL_SWITCH=true vite build --outDir dist-kill-switch",
    "e2e": "playwright test",
    "lighthouse": "lhci autorun && lhci autorun --config=lighthouserc.dark.json",
    "preview": "vite preview",
    "serve": "vite",
    "types": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@frozik/cloud-storage": "workspace:*",
    "@frozik/components": "workspace:*",
    "@frozik/table": "workspace:*",
    "@frozik/utils": "workspace:*",
    "@frozik/vault": "workspace:*",
    "@frozik/vault-app": "workspace:*",
    "@frozik/vault-browser": "workspace:*",
    "@frozik/vault-http": "workspace:*",
    "@frozik/vault-react": "workspace:*",
    "lodash-es": "catalog:",
    "lucide-react": "catalog:",
    "mobx": "catalog:",
    "mobx-react-lite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "temporal-polyfill": "catalog:",
    "usehooks-ts": "catalog:",
    "workbox-core": "catalog:",
    "workbox-precaching": "catalog:",
    "workbox-routing": "catalog:"
  },
  "devDependencies": {
    "@frozik/typescript-config": "workspace:*",
    "@frozik/vite-plugins": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:"
  }
}
