{
  "name": "@frozik/calls-filter",
  "version": "0.1.0",
  "private": true,
  "description": "Calls Filter for Android: incoming calls sorted into groups by number and name masks, each group with its own policy",
  "main": "./index.ts",
  "scripts": {
    "bundle-check": "expo export --platform android --output-dir dist",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "test": "jest",
    "types": "tsc --noEmit && tsc -p e2e",
    "build-apk": "../../libs/tooling/scripts/android/prebuild.sh CALLS_FILTER_SMS CALLS_FILTER_VERSION CALLS_FILTER_VERSION_CODE && cd android && ./gradlew assembleRelease --no-daemon",
    "e2e-android": "./e2e-android.sh",
    "sign-apk": "./sign-apk.sh",
    "kotlin-check": "../../libs/tooling/scripts/android/prebuild.sh CALLS_FILTER_SMS CALLS_FILTER_VERSION CALLS_FILTER_VERSION_CODE && cd android && ./gradlew :call-screening:ktlint :call-screening:detekt :call-screening:testDebugUnitTest --no-daemon"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@formatjs/intl-pluralrules": "catalog:",
    "@frozik/cloud-storage": "workspace:*",
    "@frozik/components": "workspace:*",
    "@frozik/expo-google-authorization": "workspace:*",
    "@frozik/proto": "workspace:*",
    "@frozik/utils": "workspace:*",
    "@react-native-community/datetimepicker": "catalog:",
    "expo": "catalog:",
    "expo-background-task": "catalog:",
    "expo-calendar": "catalog:",
    "expo-clipboard": "catalog:",
    "expo-constants": "catalog:",
    "expo-contacts": "catalog:",
    "expo-crypto": "catalog:",
    "expo-file-system": "catalog:",
    "expo-linking": "catalog:",
    "expo-localization": "catalog:",
    "expo-location": "catalog:",
    "expo-router": "catalog:",
    "expo-sharing": "catalog:",
    "expo-sqlite": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
    "expo-task-manager": "catalog:",
    "ical.js": "catalog:",
    "leaflet": "catalog:",
    "libphonenumber-js": "catalog:",
    "lodash-es": "catalog:",
    "lucide-react-native": "catalog:",
    "mobx": "catalog:",
    "mobx-react-lite": "catalog:",
    "react": "catalog:native",
    "react-dom": "catalog:native",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:",
    "react-native-webview": "catalog:",
    "react-native-worklets": "catalog:",
    "rrule-temporal": "catalog:",
    "temporal-polyfill": "catalog:",
    "usehooks-ts": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "catalog:",
    "@frozik/tooling": "workspace:*",
    "@frozik/typescript-config": "workspace:*",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/leaflet": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:native",
    "babel-preset-expo": "catalog:",
    "fast-check": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "test-renderer": "catalog:"
  }
}
