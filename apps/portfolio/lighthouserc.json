{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec vite preview --port 4173 --strictPort",
      "startServerReadyPattern": "localhost:4173",
      "url": ["http://localhost:4173/portfolio/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "resource-summary:script:size": [
          "error",
          { "maxNumericValue": 250000 }
        ],
        "resource-summary:stylesheet:size": [
          "error",
          { "maxNumericValue": 25000 }
        ],
        "resource-summary:third-party:size": [
          "error",
          { "maxNumericValue": 15000 }
        ],
        "resource-summary:total:size": ["error", { "maxNumericValue": 350000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
