    "@frozik/vault-app": "workspace:*",
    "@frozik/vault-http": "workspace:*",
    "@shopify/flash-list": "catalog:",
    "expo": "catalog:",
    "expo-clipboard": "catalog:",
    "expo-constants": "catalog:",
    "expo-document-picker": "catalog:",
