{
  "name": "@frozik/vault-native",
  "version": "0.1.0",
  "private": true,
  "description": "Ciphra Vault for Android: the same vault, on the phone",
  "main": "./index.ts",
  "scripts": {
    "bundle-check": "expo export --platform android --output-dir dist",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "test": "jest",
    "types": "tsc --noEmit",
    "build-apk": "expo prebuild --platform android --no-install --clean && cd android && ./gradlew assembleRelease --no-daemon",
    "e2e-android": "./e2e-android.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "catalog:",
