{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "semi": true,
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": {
    "partitionByNewline": true,
    "newlinesBetween": false
  },
  "overrides": [
    {
      "files": ["**/*.json", "**/*.jsonc"],
      "options": { "printWidth": 80 }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dev-dist/**",
    "**/build/**",
    "**/coverage/**",
    ".moon/**",
    ".claude/**",
    "**/*.md",
    "**/*.html",
    "**/*.yml",
    "**/*.yaml",
    "pnpm-lock.yaml",
    ".dependency-cruiser-known-violations.json",
    ".file-size-baseline.json",
    "apps/portfolio/bundle-stats.json"
  ]
}
