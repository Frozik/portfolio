{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["libs/typescript-config"],
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "lighthouse",
        "@swc/core",
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        "@semantic-release/github",
        "conventional-changelog-conventionalcommits"
      ]
    },
    "apps/portfolio": {
      "entry": [
        "src/sw/sw.ts",
        "src/app/prerender/render-landing.tsx",
        "lighthouserc.json",
        "e2e/**/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "e2e/**/*.ts"],
      "ignoreDependencies": ["buffer"]
    },
    "apps/communication": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["pino-pretty", "toml"]
    },
    "libs/utils": {
      "entry": ["src/**/*.ts!"],
      "project": ["src/**/*.ts"]
    },
    "libs/components": {
      "entry": ["src/**/*.{ts,tsx}!"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "libs/table": {
      "entry": ["src/**/*.{ts,tsx}!"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "libs/charts": {
      "entry": ["src/**/*.{ts,tsx}!"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "libs/communication-protocol": {
      "entry": ["src/**/*.ts!"],
      "project": ["src/**/*.ts"]
    },
    "libs/tooling": {
      "project": ["src/**/*.ts"]
    }
  },
  "rules": {
    "duplicates": "off",
    "exports": "error",
    "types": "error",
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "enumMembers": "off"
  }
}
