{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["libs/typescript-config"],
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "lighthouse",
        "@swc/core",
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        "@semantic-release/github",
        "conventional-changelog-conventionalcommits"
      ]
    },
    "apps/portfolio": {
      "entry": [
        "src/sw/sw.ts",
        "src/app/prerender/render-landing.tsx",
        "lighthouserc.json",
        "e2e/**/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "e2e/**/*.ts"],
      "ignoreDependencies": ["streamsaver"]
    },
    "apps/communication": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["pino-pretty", "toml"]
    },
    "apps/vault-extension": {
      "entry": ["src/entrypoints/**/*.{ts,tsx}", "e2e/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"]
    },
    "apps/vault-web": {
      "entry": ["e2e/**/*.ts"],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "vite-plugins/**/*.ts",
        "e2e/**/*.ts"
      ]
    },
    "apps/vault-native": {
      "entry": ["src/app/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx}", "*.ts"],
      "ignoreBinaries": ["maestro"]
    },
    "libs/utils": {
      "entry": ["src/**/*.ts!"],
      "project": ["src/**/*.ts"]
    },
    "libs/components": {
      "entry": ["src/**/*.{ts,tsx}!"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["buffer"]
    },
    "libs/table": {
      "entry": ["src/**/*.{ts,tsx}!"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "libs/charts": {
      "entry": ["src/**/*.{ts,tsx}!"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "libs/bug-reporter": {
      "entry": ["src/**/*.{ts,tsx}!"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "libs/vault": {
      "entry": ["src/**/*.{ts,tsx}!"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "libs/vault-browser": {
      "entry": ["src/**/*.ts!"],
      "project": ["src/**/*.ts"]
    },
    "libs/vault-http": {
      "entry": ["src/**/*.ts!"],
      "project": ["src/**/*.ts"]
    },
    "libs/vault-react": {
      "entry": ["src/**/*.{ts,tsx}!"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "libs/vault-app": {
      "entry": ["src/**/*.ts!"],
      "project": ["src/**/*.ts"]
    },
    "libs/cloud-storage": {
      "entry": ["src/**/*.ts!"],
      "project": ["src/**/*.ts"]
    },
    "libs/communication-protocol": {
      "entry": ["src/**/*.ts!"],
      "project": ["src/**/*.ts"]
    },
    "libs/tooling": {
      "project": ["src/**/*.ts"]
    },
    "libs/transport": {
      "entry": ["src/**/*.ts!"],
      "project": ["src/**/*.ts"]
    },
    "libs/proto": {
      "entry": ["src/**/*.ts!"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@bufbuild/protoc-gen-es"],
      "ignoreBinaries": ["diff"]
    },
    "libs/vite-plugins": {
      "entry": ["src/**/*.ts!"],
      "project": ["src/**/*.ts"]
    }
  },
  "rules": {
    "duplicates": "off",
    "exports": "error",
    "types": "error",
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "enumMembers": "off"
  }
}
