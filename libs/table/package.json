{
  "name": "@frozik/table",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./core/*": "./src/core/*.ts",
    "./extensions/*": "./src/extensions/*.ts",
    "./react/column": "./src/react/column.ts",
    "./react/slots": "./src/react/slots.ts",
    "./react/translations/*": "./src/react/translations/*.ts",
    "./react/*": "./src/react/*.tsx",
    "./theme/*": "./src/theme/*"
  },
  "scripts": {
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@frozik/components": "workspace:*",
    "@frozik/utils": "workspace:*",
    "lodash-es": "catalog:",
    "temporal-polyfill": "catalog:",
    "usehooks-ts": "catalog:"
  },
  "devDependencies": {
    "@frozik/typescript-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  },
  "peerDependencies": {
    "mobx": "catalog:",
    "mobx-react-lite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
